<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Панель управления" Width="1060" Height="820" MinWidth="880" MinHeight="620" Background="{DynamicResource ThemePanel}" Foreground="{DynamicResource ThemeText}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemePrimary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <SolidColorBrush x:Key="ThemePanel" Color="#101411"/>
  <SolidColorBrush x:Key="ThemeSidebar" Color="#141A16"/>
  <SolidColorBrush x:Key="ThemeCard" Color="#191F1B"/>
  <SolidColorBrush x:Key="ThemeBorder" Color="#2B352E"/>
  <SolidColorBrush x:Key="ThemeButton" Color="#26312A"/>
  <SolidColorBrush x:Key="ThemeButtonBorder" Color="#35453A"/>
  <SolidColorBrush x:Key="ThemeHover" Color="#36483C"/>
  <SolidColorBrush x:Key="ThemePrimary" Color="#386347"/>
  <SolidColorBrush x:Key="ThemePrimaryBorder" Color="#568B67"/>
  <SolidColorBrush x:Key="ThemeAccent" Color="#83D9A3"/>
  <SolidColorBrush x:Key="ThemeText" Color="#EDF3EE"/>
  <SolidColorBrush x:Key="ThemeMuted" Color="#98A99D"/>
  <SolidColorBrush x:Key="ThemeToggleOff" Color="#3D4841"/>
  <SolidColorBrush x:Key="ThemeToggleOn" Color="#468D5E"/>
  <SolidColorBrush x:Key="ThemeToggleThumb" Color="#F1F5F2"/>
  <SolidColorBrush x:Key="ThemeScroll" Color="#46574B"/>
  <SolidColorBrush x:Key="ThemePopup" Color="#1C251F"/>


  <Style x:Key="ScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="24"/><Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="7,0">
    <Border Height="5" Background="{TemplateBinding Foreground}" CornerRadius="3" VerticalAlignment="Center" Opacity="0.65"/>
    <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
     <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="16" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="16" Height="16" Fill="#EDF3EE" Stroke="#26312A" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
    </Track>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="Background" Value="{DynamicResource ThemeSidebar}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Border Background="{TemplateBinding Background}" CornerRadius="6"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{DynamicResource ThemeScroll}" CornerRadius="5" Margin="2" MinHeight="24"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource ThemeAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
    </Track></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Padding" Value="12,9"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource ThemePrimary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeButton}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeScroll}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Box" Background="{DynamicResource ThemeButton}" BorderBrush="{DynamicResource ThemeScroll}" BorderThickness="1" CornerRadius="8"><Grid><Path Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource ThemeMuted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,10,36,10" IsHitTestVisible="False" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource ThemePopup}" BorderBrush="{DynamicResource ThemeScroll}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource ThemeCard}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeButton}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Body" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource ThemeHover}"/><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource ThemePrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryBorder}"/></Style>
  <Style x:Key="NameEditor" TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="Transparent"/><Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="0,3,0,6"/><Setter Property="MaxLength" Value="32"/>
   <Setter Property="ToolTip" Value="Нажмите, чтобы изменить имя. Enter — сохранить, Escape — отменить."/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Underline" BorderThickness="0,0,0,1" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Margin" Value="0,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0"/>
     <Border x:Name="Track" Grid.Column="1" Width="44" Height="25" CornerRadius="13" Background="{DynamicResource ThemeToggleOff}"><Ellipse x:Name="Thumb" Width="19" Height="19" Fill="{DynamicResource ThemeToggleThumb}" HorizontalAlignment="Left" Margin="3,0,0,0"><Ellipse.RenderTransform><TranslateTransform x:Name="Slide"/></Ellipse.RenderTransform></Ellipse></Border>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeToggleOn}"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="19" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid x:Name="RootLayout" IsEnabled="False">
   <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource ThemeSidebar}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="18,26">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="EFREN" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/><TextBlock Text="Панель управления" Style="{StaticResource Muted}" Margin="0,5,0,35"/>
      <Button x:Name="NavOverview" Content="Обзор" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavSettings" Content="Настройки" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavVoices" Content="Голоса" HorizontalContentAlignment="Left"/>
      <Button x:Name="Appearance" Content="Оформление" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavTools" Content="Инструменты" HorizontalContentAlignment="Left"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><Button x:Name="Legacy" Content="Прежняя панель" FontSize="12" Padding="10,8"/><Button x:Name="Project" Content="Папка проекта" FontSize="12" Padding="10,8"/></StackPanel>
     <Border/>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="28,24,28,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24"><Button x:Name="Refresh" DockPanel.Dock="Right" Content="Обновить" Margin="12,0,0,0"/><StackPanel><TextBlock x:Name="PageTitle" Text="Твои помощники" FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="Голос, команды и управление — в одном месте" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></DockPanel>
    <Border x:Name="ErrorBar" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Background="#432A29" Padding="12" Margin="0,0,0,14"><TextBlock x:Name="ErrorText" Foreground="#FFB8AE"/></Border>
    <ContentControl x:Name="AppearancePage" Grid.Row="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <ContentControl x:Name="WorkspacePage" Grid.Row="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <ScrollViewer x:Name="MainPages" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
     <Grid>
      <StackPanel x:Name="OverviewPage">
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock x:Name="ConsoleTitle" Text="Команды и озвучка" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Enter — выполнить команду · Ctrl+Enter — только озвучить" Style="{StaticResource Muted}" Margin="0,8,0,12"/>
        <TextBox x:Name="ConsoleInput" MaxLength="400" Background="{DynamicResource ThemeButton}" Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeButtonBorder}" Padding="12" FontSize="15" Margin="0,0,0,12"/>
        <WrapPanel><Button x:Name="ConsoleCommand" Content="Выполнить" Style="{StaticResource Primary}"/><Button x:Name="ConsoleSpeech" Content="Только озвучить"/></WrapPanel>
        <TextBlock x:Name="ConsoleStatus" Text="Результат команды появится в журнале помощника." Style="{StaticResource Muted}"/>
        <Button x:Name="FavoriteAdd" Content="★ Добавить текст в избранное" HorizontalAlignment="Left" Margin="0,12,0,8"/>
        <WrapPanel x:Name="Favorites"/>
        <TextBlock Text="Избранное: нажатие выполняет команду, правый клик — удаляет кнопку." Style="{StaticResource Muted}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel>
        <DockPanel><TextBlock x:Name="FridayState" DockPanel.Dock="Right" Text="Проверяю…" Foreground="{DynamicResource ThemeAccent}" FontSize="12" Margin="14,12,0,0"/><TextBox x:Name="FridayName" Style="{StaticResource NameEditor}" Text="Пятница"/></DockPanel>
        <TextBlock Text="Помощник в Discord" Style="{StaticResource Muted}" Margin="0,5,0,18"/>
        <WrapPanel><Button x:Name="FridayStart" Style="{StaticResource Primary}" Content="Запустить"/><Button x:Name="FridayStop" Content="Остановить"/><Button x:Name="FridayRestart" Content="Перезапустить"/></WrapPanel>
        <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,10,0,17"/>
        <WrapPanel><Button x:Name="FridayLog" Content="Журнал и команды"/><Button x:Name="Roles" Content="Участники войса"/><Button x:Name="Training" Content="Обучение распознавания"/><Button x:Name="VoiceRestart" Content="Перезапустить голос"/></WrapPanel>
        <TextBlock x:Name="FridayHint" Text="Обращение: Пятница, рулетка" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel>
        <DockPanel><TextBlock x:Name="JarvisState" DockPanel.Dock="Right" Text="Проверяю…" Foreground="{DynamicResource ThemeMuted}" FontSize="12" Margin="14,12,0,0"/><TextBox x:Name="JarvisName" Style="{StaticResource NameEditor}" Text="Джарвис"/></DockPanel>
        <TextBlock Text="Помощник на компьютере" Style="{StaticResource Muted}" Margin="0,5,0,5"/>
        <TextBlock x:Name="JarvisStage" Text="Проверяю компоненты…" Style="{StaticResource Muted}" Margin="0,0,0,18"/>
        <Border Background="{DynamicResource ThemeButton}" BorderBrush="{DynamicResource ThemeButtonBorder}" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,0,12"><TextBlock x:Name="JarvisVoiceStatus" Text="Голос: проверяю…" Foreground="{DynamicResource ThemeAccent}"/></Border>
        <WrapPanel><Button x:Name="JarvisStart" Style="{StaticResource Primary}" Content="Запустить"/><Button x:Name="JarvisStop" Content="Остановить"/><Button x:Name="JarvisRestart" Content="Перезапустить"/></WrapPanel>
        <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,10,0,17"/>
        <WrapPanel><Button x:Name="JarvisLog" Content="История команд"/><Button x:Name="CommandList" Content="Мои команды"/><Button x:Name="Chat" Content="Текстовый чат"/><Button x:Name="Macros" Content="Создать команду"/></WrapPanel>
        <TextBlock x:Name="JarvisHint" Text="Обращение: Джарвис, открой настройки" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
       </StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock x:Name="RepliesTitle" Text="Ответы помощника" FontSize="20"/>
        <TextBlock Text="Способ подтверждения команд в Discord. Настройки сохраняются сразу." Style="{StaticResource Muted}" Margin="0,8,0,12"/>
        <TextBlock Text="Обычные команды"/><ComboBox x:Name="ReplyDefault" Margin="0,6,0,12"/>
        <TextBlock Text="Кик участника"/><ComboBox x:Name="ReplyKick" Margin="0,6,0,12"/>
        <TextBlock Text="Самокик («убей меня»)"/><ComboBox x:Name="ReplySelf" Margin="0,6,0,12"/>
        <TextBlock Text="Рулетка / случайный кик"/><ComboBox x:Name="ReplyRandom" Margin="0,6,0,12"/>
        <TextBlock Text="Массовый кик"/><ComboBox x:Name="ReplyAll" Margin="0,6,0,0"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><CheckBox x:Name="UiSounds" Content="Звуки интерфейса"/></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Речь и команды" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <CheckBox x:Name="VoiceEnabled" Content="Слушать микрофон компьютера"/><CheckBox x:Name="TtsEnabled" Content="Озвучивать ответы"/><CheckBox x:Name="DiscordEnabled" Content="Команды Discord"/><CheckBox x:Name="WindowsEnabled" Content="Команды Windows"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Голос помощника" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Просмотр и установка RVC-голосов напрямую из публичного каталога Hugging Face. Файлы устанавливаются автоматически." Style="{StaticResource Muted}" Margin="0,8,0,14" TextWrapping="Wrap"/><Button x:Name="VoiceStore" Content="Открыть магазин голосов" HorizontalAlignment="Left"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Участники Discord" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <CheckBox x:Name="FriendsVoice" Content="Слушать участников войса"/><CheckBox x:Name="FriendsCommands" Content="Разрешить участникам команды Discord"/>
        <TextBlock Text="Права конкретного участника задаются в окне ролей." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Qwen" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Когда запускать локальную языковую модель" Style="{StaticResource Muted}" Margin="0,5,0,16"/>
        <WrapPanel><Button x:Name="QwenOff" Content="Отключена"/><Button x:Name="QwenExplicit" Content="По команде"/><Button x:Name="QwenAuto" Content="Для неизвестных запросов"/></WrapPanel><TextBlock x:Name="QwenState" Style="{StaticResource Muted}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Браузер" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox x:Name="Browser" Padding="10" FontSize="14"/><CheckBox x:Name="BrowserClarify" Content="Уточнять выбор браузера"/></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="ToolsPage" Visibility="Collapsed">
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Полное отключение помощников" FontSize="20"/><TextBlock Text="Остановит обоих помощников и отключит речь, озвучку, команды и Qwen в настройках. Панель останется открытой. Для возврата включите нужные функции и запустите помощников." Style="{StaticResource Muted}" Margin="0,8,0,16"/><Button x:Name="FullShutdown" Content="Остановить и отключить всех" HorizontalAlignment="Left"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Автозапуск панели" FontSize="20"/><TextBlock x:Name="StartupState" Style="{StaticResource Muted}" Margin="0,8,0,16"/><WrapPanel><Button x:Name="StartupOn" Content="Включить с Windows"/><Button x:Name="StartupOff" Content="Выключить автозапуск"/></WrapPanel></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Резервная копия" FontSize="20"/><TextBlock Text="Сохраняет имена, настройки, оформление и сценарии. Пароль, журналы и модели в копию не входят." Style="{StaticResource Muted}" Margin="0,8,0,16"/><WrapPanel><Button x:Name="BackupExport" Content="Создать копию"/><Button x:Name="BackupImport" Content="Восстановить"/></WrapPanel><TextBlock x:Name="BackupStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Обновление EFREN Lite" FontSize="20"/><TextBlock Text="Проверяет официальный выпуск GitHub, сверяет SHA-256 и запускает установку новой версии." Style="{StaticResource Muted}" Margin="0,8,0,16"/><WrapPanel><Button x:Name="CheckUpdate" Content="Проверить обновления"/><Button x:Name="PanelRestart" Content="Перезапустить панель"/></WrapPanel><ProgressBar x:Name="UpdateProgress" Height="7" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,14,0,0"/><TextBlock x:Name="UpdateStatus" Text="Установлена версия определяется автоматически." Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Проверка системы" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Состояние голосовых компонентов и диагностика" Style="{StaticResource Muted}" Margin="0,8,0,20"/><Button x:Name="Diagnostics" Content="Открыть диагностику" HorizontalAlignment="Left"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Дополнительные инструменты" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Журналы, участники войса и конструктор сценариев доступны на странице «Обзор» и открываются внутри этой панели. Текстовый чат Джарвиса запускается в своей консоли." Foreground="{DynamicResource ThemeMuted}" Margin="0,12,0,0"/></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="TrainingPage" Visibility="Collapsed">
       <TextBlock Text="Это словарь замен, не переобучение модели. Исправления применяются до разбора обращения и команды, без перезапуска помощника." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Недавние непонятые фразы" Margin="0,0,0,8"/><ListBox x:Name="TrainingRecent" Height="230" Background="{DynamicResource ThemeCard}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Сохранённые исправления" Margin="0,0,0,8"/><ListBox x:Name="TrainingSaved" DisplayMemberPath="Label" Height="230" Background="{DynamicResource ThemeCard}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></StackPanel>
       </Grid>
       <TextBlock Text="Помощник услышал" Margin="0,14,0,6"/>
       <TextBox x:Name="TrainingWrong" MaxLength="400" Padding="10" Background="{DynamicResource ThemeButton}" Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeButtonBorder}"/>
       <TextBlock Text="Должен понимать" Margin="0,10,0,6"/>
       <TextBox x:Name="TrainingCorrect" MaxLength="400" Padding="10" Background="{DynamicResource ThemeButton}" Foreground="{DynamicResource ThemeText}" CaretBrush="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeButtonBorder}"/>
       <WrapPanel Margin="0,14,0,0"><Button x:Name="TrainingSave" Content="Сохранить исправление"/><Button x:Name="TrainingDelete" Content="Удалить выбранное"/><Button x:Name="TrainingRefresh" Content="Обновить список"/></WrapPanel>
       <TextBlock x:Name="TrainingStatus" Style="{StaticResource Muted}"/>
      </StackPanel>
      <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Состояние системы" FontSize="20" Margin="0,0,0,12"/><TextBlock x:Name="DiagnosticsSystem" Text="Проверяю…" LineHeight="27"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Качество распознавания" FontSize="20" Margin="0,0,0,12"/><TextBlock x:Name="DiagnosticsRecognition" Text="Нет данных" LineHeight="25"/></StackPanel></Border>
       <CheckBox x:Name="DiagnosticsAuto" Content="Автообновление, пока открыта диагностика (каждые 5 секунд)" IsChecked="True"/>
       <WrapPanel><Button x:Name="DiagnosticsRefresh" Content="Проверить сейчас"/><Button x:Name="DiagnosticsRepair" Content="Восстановить компоненты"/><Button x:Name="DiagnosticsCopy" Content="Скопировать отчёт"/></WrapPanel>
       <TextBlock x:Name="DiagnosticsStatus" Style="{StaticResource Muted}"/>
       <TextBlock Text="Проверка не перезапускает помощников. Восстановление выполняется только по кнопке; оно может прервать текущую фразу. Статус озвучки не гарантирует слышимость в Discord." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
      </StackPanel>
     </Grid>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Resources" Text="Измеряю нагрузку панели…" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" x:Name="Connection" Text="Подключение…" Style="{StaticResource Muted}"/></Grid>
   </Grid>
  </Grid>
  <Border x:Name="LoginOverlay" Background="#F5101411"><Border Background="{DynamicResource ThemePopup}" BorderBrush="{DynamicResource ThemeButtonBorder}" BorderThickness="1" CornerRadius="20" Width="370" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel><TextBlock Text="С возвращением" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Введите прежний пароль панели" Style="{StaticResource Muted}" Margin="0,10,0,24"/><PasswordBox x:Name="Password" Padding="12" FontSize="18" Background="{DynamicResource ThemeBorder}" Foreground="White" BorderBrush="#526C5B"/><TextBlock x:Name="LoginError" Foreground="#FFB8AE" Margin="0,10"/><Button x:Name="Login" Content="Войти" Style="{StaticResource Primary}" Margin="0"/></StackPanel></Border></Border>
  <Border x:Name="FirstRunOverlay" Visibility="Collapsed" Background="#F5101411"><Border Background="{DynamicResource ThemePopup}" BorderBrush="{DynamicResource ThemeButtonBorder}" BorderThickness="1" CornerRadius="20" Width="510" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel><TextBlock Text="Добро пожаловать в EFREN Lite" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Закончим первоначальную настройку. Эти параметры потом можно изменить в панели." Style="{StaticResource Muted}" Margin="0,8,0,20" TextWrapping="Wrap"/><TextBlock Text="1. Имя помощника"/><TextBox x:Name="WizardName" Text="Джарвис" MaxLength="32" Padding="10" Margin="0,6,0,15" Background="{DynamicResource ThemeButton}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeButtonBorder}"/><TextBlock Text="2. Микрофон и динамики"/><TextBlock Text="EFREN использует устройства по умолчанию в Windows." Style="{StaticResource Muted}" Margin="0,5,0,8"/><Button x:Name="WizardSound" Content="Открыть настройки звука Windows" HorizontalAlignment="Left"/><CheckBox x:Name="WizardStartup" Content="3. Запускать панель вместе с Windows" Margin="0,14,0,12"/><TextBlock x:Name="WizardStatus" Text="После завершения помощник запустится и проверит голос." Style="{StaticResource Muted}" TextWrapping="Wrap"/><Button x:Name="WizardFinish" Content="Завершить настройку и проверить" Style="{StaticResource Primary}" Margin="0,16,0,0"/></StackPanel></Border></Border>
 </Grid>
</Window>
